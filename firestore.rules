rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      // 公開読み取り可能
      allow read: if true;
      // 本人のみ書き込み可能
      allow create, update, delete: if request.auth != null && request.auth.uid == uid;
    }
  }
  match /counters/{docId} {
    allow read: if true;
    allow write: if false;
  }
}