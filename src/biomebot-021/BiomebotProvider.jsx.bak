/*
BiomebotProvider-021
====================

チャットボットの排他制御、出現管理、およびデータの更新管理を行い、
UIおよびfirestoreなどのクラウドストレージとのインタフェースを提供する

## チャットボットの排他制御
useBroadcastLockを利用し、マシン内で同じbotIdのインスタンスは最大１つしか
起動しないように制限する。
また/commonsを開いている間はその部屋にチャットボットが存在したら、ローカルで
同じbotIdのインスタンスはejectする。

## チャットボットの出現管理
各チャットボットはそれぞれ時間帯や天候で出現確率が変動する。それを踏まえて
ルームにチャットボットが出現するかどうかを決める。

## データの更新
ソースはgraphql上にあり、それを各種Storeにロードして使用する。
会話を通してチャットボットは新しい情報を学習し、Storeに追記される。

学習した内容はサーバー側にも記憶し、ブラウザをまたいでも記憶が整合的である
ようにする。ユーザが明示的に退室した場合はそれをfirestoreに書き出すが、
ブラウザ終了時にこの処理が安定して実行できないことがあるのを想定し、チャットボットを
deployする前にdexieの記憶とfirestoreの記憶を同期する。


*/
import React, { useReducer, useRef, useEffect, createContext, useContext } from 'react';
import { useStaticQuery, graphql } from 'gatsby';

import { EcosystemContext } from '../components/Ecosystem/EcosystemProvider';
import { useBroadcastLock } from './useBroadcastLock';
import Biomebot from './biomebot';

export const BiomebotContext = createContext();
const isBrowser = typeof window !== 'undefined';

const biomebotQuery = graphql`
query MyQuery {
  allBiomebotConfig {
    nodes {
      avatarDir
      backgroundColor
      badWeatherAppearanceAdjustment
      botId
      daytimeAppearanceAdjustment
      goodWeatherAppearanceAdjustment
      nighttimeAppearanceAdjustment
      spontaneousAppearanceRate
      summonAppearanceRate
      talkResumingRate
      parent {
        ... on File {
          name
          relativeDirectory
        }
      }
    }
  }
  allConceptStore {
    nodes {
      triples {
        object
        predicate
        subject
      }
      parent {
        ... on File {
          name
          relativeDirectory
        }
      }
    }
  }
  allDialogStore {
    nodes {
      messages {
        speaker
        text
        timestamp {
          date
          time
        }
      }
      tags {
        key
        value
      }
      parent {
        ... on File {
          name
          relativeDirectory
        }
      }
    }
  }
  site {
    siteMetadata {
      backgroundColorPalette
      balloonBackgroundAlpha
      heartbeatInterval
      title
    }
  }
}
`;

/**
 * snapをチャットボットごとに分割
 * @param {object} graphqlSnap
 * @returns [botId]: {[moduleName]:{ext:string, content:string}}
 */
function splitSnapsByBotId(graphqlSnap) {
  /*
  snap={
    botId: {
      config: {},
      concept: {moduleName: {
        triples: [],
        },
      },
      dialog: {moduleName: {
        messages: [],
        tags: {}
       },
      }
    }
  } 
  
  */
  let config = {}
  for (let node of graphqlSnap.allBiomebotConfig.nodes) {
    const p = node.parent;
    const botId = p.relativeDirectory;
    config[botId].configs = { ...node };
  }

  let concepts = {}
  for (let node of graphqlSnap.allConceptStore.nodes) {
    const p = node.parent;
    const botId = p.relativeDirectory;
    const moduleName = p.name;
    if (!(botId in concepts)) {
      concepts[botId] = {};
    }
    if (!(moduleName in concepts[botId])) {
      concepts[botId][moduleName] = { triples: [] };
    }
    concepts[botId][moduleName] = { tripels: [...node.triples] };
  }

  let dialogs = {};
  for (let node of graphqlSnap.allDialogStore.nodes) {
    const p = node.parent;
    const botId = p.relativeDirectory;
    const moduleName = p.name;
    if (!(botId in dialogs)) {
      dialogs[botId] = {};
    }
    if (!(moduleName in dialogs[botId])) {
      dialogs[botId][moduleName] = { tags: {}, messages: [] };
    }
    dialogs[botId][moduleName] = { tags: { ...node.tags }, messages: [...node.messages] };
  }

  return [
    config, concepts, dialogs
  ];
}

const interpolate = (start, end, factor) => {
  return Math.round(start + (end - start) * factor);
};


function hexToLightness(hexColor) {
  // 先頭の # を除去
  const hex = hexColor.replace(/^#/, '');

  // RGBに分解
  const r = parseInt(hex.substring(0, 2), 16) / 255;
  const g = parseInt(hex.substring(2, 4), 16) / 255;
  const b = parseInt(hex.substring(4, 6), 16) / 255;

  // HSL変換のための最大・最小値
  const max = Math.max(r, g, b);
  const min = Math.min(r, g, b);

  // 明度（Lightness）の計算
  const lightness = (max + min) / 2;

  return lightness;
}



const initialState = {
  botIds: [],
  botConfigs: {},
  botStatus: {},  // [botId]: "" or "deploying" OR "deploy"
  workerStatus: {},
  channels: {},
}

function reducer(state, action) {
  switch (action.type) {
    case 'init': {
      console.log("action", action)
      return {
        ...state,
        botIds: Object.keys(action.configs),
        channels: { ...action.channels },
        botStatus: { ...action.botStatus },
        botConfigs: { ...action.botConfigs }
      }
    }

    case 'getBiomebotStatus': {
      return {
        ...state,
        botStatus: action.botStatus,
        workerStatus: action.workerStatus
      }
    }

    default: {
      throw new Error(`BiomebotProvider:invalid action ${action}`)
    }
  }
}

export default function BiomebotProvider({ children }) {
  const [state, dispatch] = useReducer(reducer, initialState);
  const [lockState, requestLock, forceLock, unlock] =
    useBroadcastLock("biomebot", handleEject, snap.site.siteMetadata.hearbeatInterval)
  const eco = useContext(EcosystemContext);
  const botPool = useRef({});
  const snap = useStaticQuery(biomebotQuery);

  // -----------------------------------------------------------
  // Biomebot関連
  //

  useEffect(() => {
    if (!isBrowser) return;
    if (state.botIds.length > 0) return;

    const [botConfig, concepts, dialogs] = splitSnapsByBotId(snap);
    const bots = botPool.current; // snapshot
    const channels = {};
    const cleanups = [];
    const botStatus = {};

    for (const botId of Object.keys(botConfig)) {
      bots[botId] = new Biomebot(botId, botConfig[botId], concepts[botId], dialogs[botId]);
      botStatus[botId] = bots[botId].getStatus();

      cleanups.push(() => {
        try {
          const d = bots[botId]?.destroy?.();
          if (d && typeof d.then === 'function') d.catch(() => { });
        } catch { }
      });

    }

    dispatch({ type: 'init', configs: botConfig, channels, botStatus, botConfigs: botConfig });

    return () => {
      for (const fn of cleanups) {
        try { fn(); } catch { }
      }
      unlock();
    };
  }, [state.botIds.length, snap]);

  // チャットボットの排他制御で強制退室が生じた場合の処理
  function handleEject(botId) {
    // 退室処理
    unlock(botId);
  }

  /**
   * biomebotとそのworkersのステータスを収集
   * 
   */
  async function handleGetStatus() {

    // biomebotインスタンス（workerではない)のステータス問い合わせ
    let botStatus = {}
    for (let botId of state.botIds) {
      botStatus[botId] = botPool.current[botId].getStatus();
    }
    console.log("botStatus", botStatus)

    dispatch({ type: 'getBiomebotStatus', botStatus: botStatus });

    // workerのステータス問い合わせ
  }

  /**
   * チャットボットの自発的起動
   */
  async function encounter(botId) {
    /*
    自発的出現率はbotConfigs.spontaneousAppearanceRateの確率で決まるが、
    この確率に天候と時刻の補正がかかる。
    晴天時にはgoodWeatherAppearanceAdjustment、悪天候時には
    badWeatherAppearanceAdjustment値が確率に加算される。天気そのものは
    ecosystem.barometerで0〜1の連続値として取得できるため、補正値もその
    間の値となるよう比例配分する。

    | 天候   | eco.barometer | botConfigs                      |
    |--------|---------------|---------------------------------|
    | 悪天候 | 0             | badWeatherAppearanceAdjustment  |
    | 好天   | 1             | goodWeatherAppearanceAdjestment |
    
    また夜間はnighttimeAppearanceAdjustment,昼にはdaytimeAppearance
    Adjustmentが加算される。eco.backgroundが昼夜の空の色を示して
    いるため、その明度を0-1に変換して同様に補正する。
    */

    // step 1 ブラウザロックの確認
    if (botId in lockState.locked || botId in lockState.recieved) return;

    // step 2 出現ロール
    const bc = state.botConfigs[botId];
    const prob = bc.spontaneousAppearanceRate
      + interpolate(bc.badWeatherAppearanceAdjustment, bc.goodWeatherAppearanceAdjustment, eco.barometer)
      + interpolate(bc.nighttimeAppearanceAdjustment, bc.daytimeAppearanceAdjustment, hexToLightness(eco.backgroundColor));
    if (Math.random() > prob) {
      // 出現ロール失敗→起動しない
      return
    }
    // ロック確認
    if (!requestLock(botId)) return;

    // step 3 チャットボットの起動

    await deploy(botId);

  }

  async function deploy(botId) {
    /*
    チャットボットを起動しheatbeatを始動
    */
  }


  return (
    <BiomebotContext.Provider
      value={{
        botStatus: state.botStatus,
        getStatus: handleGetStatus
      }}
    >
      {state.botIds ? children : "loading..."}
    </BiomebotContext.Provider>
  )
}